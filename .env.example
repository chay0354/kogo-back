# Copy into Vercel Project → Settings → Environment Variables (Production / Preview).
# For local dev, copy to `.env` in this folder (never commit `.env`).

SECRET_KEY=
DEBUG=false

# Comma-separated hosts (include your Vercel deployment hostname, e.g. kogo-back-xxxx.vercel.app)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Postgres / Supabase (required — no SQLite)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Frontend origins (comma-separated). All https://*.vercel.app hosts are also allowed via regex unless
# CORS_DISABLE_VERCEL_REGEX=true.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Extra CSRF origins for the browser app (comma-separated full origins with scheme)
CSRF_TRUSTED_ORIGINS_EXTRA=https://your-app.vercel.app,http://localhost:3000

# Optional: set true to disable *.vercel.app CORS regex (then list every preview URL in CORS_ALLOWED_ORIGINS)
# CORS_DISABLE_VERCEL_REGEX=false

# B2C public website integration (stock sync + web orders)
WEBSITE_INTEGRATION_URL=http://localhost:3001
WEBSITE_INTEGRATION_API_KEY=kogo-b2c-crm-integration-dev

# Payments / integrations (set real values in production)
TRANZILA_TERMINAL=
TRANZILA_SUPPLIER=
TRANZILA_PUBLIC_KEY=
TRANZILA_SECRET_KEY=
TRANZILA_WEBHOOK_SECRET=
TRANZILA_API_BASE_URL=https://api.tranzila.com
TRANZILA_BASE_URL=https://direct.tranzila.com
TRANZILA_ENVIRONMENT=production
# Required for iframe payments on terminals with Handshake enabled (Tranzila DirectNG)
TRANZILA_HANDSHAKE_ENABLED=true
# Billing terminal for official tax documents (store + document wizard). Leave empty to skip.
TRANZILA_BILLING_TERMINAL=
# Optional: use DirectNG iframe host (recommended by Tranzila docs)
# TRANZILA_BASE_URL=https://directng.tranzila.com

# Outbound email (store invoice receipts + document payment reminders)
# Prefer Resend on Vercel — set RESEND_API_KEY (SMTP optional fallback)
RESEND_API_KEY=
# e.g. Cogomelo <orders@cogopass.site> after domain verified on Resend
RESEND_FROM_EMAIL=Cogomelo <orders@cogopass.site>
# CRM login app (password-reset links). Falls back to first CORS_ALLOWED_ORIGINS entry.
CRM_FRONTEND_URL=https://your-crm.vercel.app
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@kogomalo.com

# Supabase (optional; used by dashboard / server features)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Celery: not available as a long-running worker on Vercel; point to Redis only if you run workers elsewhere
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
